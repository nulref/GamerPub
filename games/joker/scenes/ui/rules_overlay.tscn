text = "Match the cards and hit the table."
horizontal_alignment = 1

[node name="Body" type="RichTextLabel" parent="ScreenMargin/Center/Panel/Margin/Column"]
custom_minimum_size = Vector2(0, 380)
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/default_color = Color(0.79, 0.86, 0.91, 1)
theme_override_colors/font_selected_color = Color(0.09, 0.075, 0.035, 1)
theme_override_colors/selection_color = Color(0.945, 0.63, 0.145, 0.9)
theme_override_font_sizes/normal_font_size = 16
theme_override_font_sizes/bold_font_size = 16
bbcode_enabled = true
text = "Seventeen cards are divided among four players. On each turn, pass one card to the player on your right.\n\nThe first player to complete a set and slap the table wins the round.\n\n[b]THREE KINDS OF SETS[/b]\n• Four cards of the same number.\n• Three cards of the same number plus the Joker.\n• Four cards of the same number plus the Joker.\n\n[b]WHEN SOMEONE SLAPS[/b]\nSlap the table fast or you may get a letter:\n• Four of a kind: the last player to slap gets a letter.\n• Three plus the Joker: the last two players get a letter.\n• Four plus the Joker: everyone except the winner gets a letter.\n\nThe first player to spell JOKER loses the game."
fit_content = false
scroll_active = true

[node name="Reminder" type="Label" parent="ScreenMargin/Center/Panel/Margin/Column"]
layout_mode = 2
theme_override_colors/font_color = Color(0.945, 0.63, 0.145, 1)
theme_override_font_sizes/font_size = 16
text = "Remember: this isn't about winning. It's about not being the Joker."
horizontal_alignment = 1
autowrap_mode = 2

