/index.html
  Cache-Control: public, max-age=0, must-revalidate

/game-manifest.json
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/game/*
  Cache-Control: public, max-age=31536000, immutable

/*
  Permissions-Policy: microphone=(self)
  X-Content-Type-Options: nosniff
